# Club League — root env for docker-compose
# Compose-level settings only. App settings: apps/web/.env

# ─── Ports (host side) ─────────────────────────────────────────────────────
WEB_PORT=5173
API_PORT=8000
MOCK_SSO_PORT=9001

# ─── Frontend build args (Vite inlines at build time) ──────────────────────
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_SSO_AUTHORIZE_URL=http://127.0.0.1:9001/authorize
VITE_SSO_CLIENT_ID=club-league-dev
VITE_SSO_REDIRECT_URI=http://127.0.0.1:5173/auth/callback
