# Club League — root env for docker-compose
# Compose-level settings only. App settings: apps/api/.env

# ─── Ports (host side) ─────────────────────────────────────────────────────
WEB_PORT=5173
API_PORT=8000
DB_PORT=5432
MOCK_SSO_PORT=9001
SWAGGER_PORT=8080

# ─── PostgreSQL ────────────────────────────────────────────────────────────
POSTGRES_USER=club_league
POSTGRES_PASSWORD=club_league
POSTGRES_DB=club_league

# ─── Shared SSO client credentials (mock-sso provider + api client) ────────
SSO_CLIENT_ID=club-league-dev
SSO_CLIENT_SECRET=club-league-dev-secret
