# Application
APP_NAME=Club League API
APP_ENV=development
DEBUG=true
API_PREFIX=/api

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://club_league:club_league@127.0.0.1:5432/club_league

# Auth
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# SSO — dev: apps/mock-sso. Production: replace with university OAuth2 URLs.
# Roles/can_sudo are NEVER taken from SSO (stored only in our DB).
SSO_AUTHORIZE_URL=http://127.0.0.1:9001/authorize
SSO_TOKEN_URL=http://127.0.0.1:9001/token
SSO_USERINFO_URL=http://127.0.0.1:9001/userinfo
SSO_CLIENT_ID=club-league-dev
SSO_CLIENT_SECRET=club-league-dev-secret
SSO_REDIRECT_URI=http://127.0.0.1:9001/callback
CORS_ORIGINS=http://localhost:9001,http://127.0.0.1:9001,http://localhost:5173,http://127.0.0.1:5173

# Business rules
DEADLINE_SOFT_WARNING_DAYS=7
ALLOWED_LINK_DOMAINS=docs.google.com,drive.google.com,t.me,telegram.me,telegram.dog,vk.com,m.vk.com,youtu.be,youtube.com,disk.yandex.ru,disk.yandex.com,yadi.sk,github.com,github.io,notion.so,notion.site,dropbox.com,dropbox.tech,innopolis.university,www.innopolis.university

# Yandex Disk WebDAV (rating CSV mirror, overwrite PUT)
# Password = 16-char application password from https://yandex.ru/dev/disk/
# Username = Yandex login (without @yandex.ru)
YANDEX_SHEETS_ENABLED=false
YANDEX_WEBDAV_USERNAME=
YANDEX_WEBDAV_PASSWORD=
YANDEX_WEBDAV_BASE=https://webdav.yandex.ru
YANDEX_DISK_PATH=club-league/rating.csv
SYNC_DEBOUNCE_SECONDS=3600
SYNC_MAX_RETRIES=3
SYNC_RETRY_BASE_SECONDS=0.5
CURRENT_SEMESTER=2026-fall
APPROVED_AUTO_COMPLETE_DAYS=7
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60


