model User {
  id            String         @id @default(uuid())
  sso_id        String         @unique
  email         String         @unique
  name          String
  role          UserRole       @default(GUEST)
  can_sudo      Boolean        @default(false)
  clubLeaderships ClubLeader[]
  moderatedReports Report[]    @relation("ModeratedReports")
  auditLogs     AuditLog[]
  createdAt     DateTime       @default(now())
}

model Club {
  id          String         @id @default(uuid())
  name        String
  category    ClubCategory   // SPORT, TECH, ART, SPECIAL_INTEREST
  leaders     ClubLeader[]
  reports     Report[]
}

model ClubLeader {
  id        String   @id @default(uuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  isPrimary Boolean  @default(false)
  @@unique([clubId, userId])
}

model Criteria {
  id          String           @id @default(uuid())
  code        String           @unique // "C1", "S1", etc.
  nameRu      String
  nameEn      String
  category    ClubCategory?    // NULL means common for all
  rules       CriteriaRule[]
}

model CriteriaRule {
  id          String     @id @default(uuid())
  criteriaId  String
  criteria    Criteria   @relation(fields: [criteriaId], references: [id])
  ruleType    String     // "tiered", "scale", "monthly_cap", "combined_cap", etc.
  config      Json       // Строго валидируется Pydantic-схемой на уровне приложения
  priority    Int        @default(0)
  versionId   String
  version     RulesVersion @relation(fields: [versionId], references: [id])
}

model RulesVersion {
  id          String         @id @default(uuid())
  semester    String         // "2026-fall"
  validFrom   DateTime
  rules       CriteriaRule[]
  reports     Report[]
}

model Report {
  id               String         @id @default(uuid())
  clubId           String
  club             Club           @relation(fields: [clubId], references: [id])
  criteriaId       String
  criteria         Criteria       @relation(fields: [criteriaId], references: [id])
  rulesVersionId   String
  rulesVersion     RulesVersion   @relation(fields: [rulesVersionId], references: [id])
  
  activityDate     DateTime       // Дата события (для расчёта 7-дневного дедлайна)
  reportData       Json           // Данные отчёта (участники, ссылки и т.д.)
  
  status           ReportStatus   @default(DRAFT)
  calculatedPoints Int?
  finalPoints      Int?
  
  isDeleted        Boolean        @default(false)
  deletedAt        DateTime?
  
  archiveBatchId   String?
  archiveBatch     ArchiveBatch?  @relation(fields: [archiveBatchId], references: [id])
  
  moderatedById    String?
  moderatedBy      User?          @relation("ModeratedReports", fields: [moderatedById], references: [id])
  moderatedAt      DateTime?
  moderationComment String?

  links            ReportLink[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model ReportLink {
  id        String   @id @default(uuid())
  reportId  String
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  url       String
  domain    String
  createdAt DateTime @default(now())
}

model ArchiveBatch {
  id          String   @id @default(uuid())
  period      String   // "2026-fall"
  archivedAt  DateTime @default(now())
  archivedById String
  reportCount Int
  reports     Report[]
}

model AuditLog {
  id              String   @id @default(uuid())
  seq             BigInt   @unique @default(autoincrement())
  prevHash        String   // SHA-256 предыдущей записи (для genesis: 64 нуля)
  hash            String   // SHA-256 текущей записи
  entityType      String   // "report", "rule", "user"
  entityId        String
  action          String   // "created", "status_changed", "points_updated", "sudo_action"
  oldValue        Json?
  newValue        Json?
  performedById   String
  performedBy     User     @relation(fields: [performedById], references: [id])
  performedByRole String
  performedAt     DateTime @default(now())
  reason          String?  // Обязательно для sudo-действий

  @@index([entityType, entityId])
  @@index([performedAt])
}

model SudoAction {
  id            String   @id @default(uuid())
  performedById String
  action        String   // force_status | restore_deleted | override_points
  entityType    String
  entityId      String
  oldValue      Json?
  newValue      Json?
  reason        String
  performedAt   DateTime @default(now())
}

model AccessViolation {
  id         String   @id @default(uuid())
  userId     String?
  path       String
  method     String
  detail     String
  occurredAt DateTime @default(now())
}

enum UserRole {
  GUEST
  CLUB_LEADER
  MODERATOR
}

enum ClubCategory {
  SPORT
  TECH
  ART
  SPECIAL_INTEREST
}

enum ReportStatus {
  DRAFT
  ON_MODERATION
  CHANGES_REQUIRED
  APPROVED
  DISPUTED
  COMPLETED
  CLOSED
  ARCHIVED
}